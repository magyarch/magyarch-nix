#!/usr/bin/env bash

# This file runs when a DM logs you into a graphical session.

# Gyorsan lefutó beállítások, nem kell háttérbe tenni
xsetroot -cursor_name left_ptr
xset r rate 300 40
xset s off -dpms

setbg &

# Démonok: csak akkor indulnak, ha még nem futnak
#pidof -q sxhkd  || sxhkd -c ~/nixos-flake/local-packages/dwm/sxhkdrc &
pidof -q picom  || picom --config "$HOME/.config/picom.conf" &
pidof -q dunst  || dunst &                 # notification daemon
pidof -q nm-applet || nm-applet &          # wifi/ethernet applet
pidof -q slstatus  || slstatus &

# polkit agent (NixOS: environment.pathsToLink = [ "/libexec" ]; + mate-polkit a systemPackages-ben)
pidof -q polkit-mate-authentication-agent-1 || \
  /run/current-system/sw/libexec/polkit-mate-authentication-agent-1 &

#mpd &
#unclutter &
#blueman-applet &
#udiskie -a &
